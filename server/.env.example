# Copy to .env and provide real values through your hosting provider's secret manager.
NODE_ENV=production
PORT=8080

# Database and authentication
MONGODB_URI=
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

# Canonical frontend origin used in verification emails (no trailing slash)
FRONTEND_URL=https://your-frontend-domain.example
# Optional comma-separated additional allowed origins for CORS
# FRONTEND_URLS=https://your-frontend-domain.example,https://admin.your-domain.example

# Email (required for registration verification and password-reset email)
RESEND_API=
EMAIL_FROM=Binkeyit <onboarding@resend.dev>

# Cloudinary (required for avatar uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (required only for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

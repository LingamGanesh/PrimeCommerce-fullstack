# Local backend configuration. Copy this file to server/.env.
# Never commit server/.env or paste real credentials into GitHub.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string. Insert your rotated database password locally.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/primecommerce?retryWrites=true&w=majority

# Local development can use JWT_SECRET as a shared fallback.
# For production, set two different random secrets (32+ characters) below.
JWT_SECRET=replace-with-a-long-random-local-development-secret
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=

# Optional integrations. Leave blank until configured.
RESEND_API=
EMAIL_FROM=PrimeCommerce <onboarding@resend.dev>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CRON_SECRET=

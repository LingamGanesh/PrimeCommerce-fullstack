# Server
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/primecommerce

# JWT secrets: replace with long, random values before deployment
SECRET_KEY_ACCESS_TOKEN=replace_with_a_long_random_access_secret
SECRET_KEY_REFRESH_TOKEN=replace_with_a_different_long_random_refresh_secret

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=PrimeCommerce <onboarding@resend.dev>
SUPPORT_EMAIL=

# Cloudinary (standard names are preferred; legacy CLODINARY_* aliases are also supported)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

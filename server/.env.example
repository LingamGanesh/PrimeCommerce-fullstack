# Backend
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/primecommerce

# Authentication (use long, random, different values in production)
SECRET_KEY_ACCESS_TOKEN=replace_with_a_long_random_access_secret
SECRET_KEY_REFRESH_TOKEN=replace_with_a_different_long_random_refresh_secret

# Resend email delivery (RESEND_API_KEY is preferred; RESEND_API is also supported)
RESEND_API_KEY=re_your_resend_api_key
# For local testing, onboarding@resend.dev can only send to an address permitted by Resend.
# For real customer emails, verify your sending domain in Resend and use its sender address.
EMAIL_FROM=PrimeCommerce <onboarding@resend.dev>

# Cloudinary (variable names retained for compatibility with existing code)
CLODINARY_CLOUD_NAME=your_cloud_name
CLODINARY_API_KEY=your_cloudinary_api_key
CLODINARY_API_SECRET_KEY=your_cloudinary_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
